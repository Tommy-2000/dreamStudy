{
  "expo": {
    "name": "dreamstudy-student",
    "slug": "dreamstudy-student",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dreamstudy-student",
    "userInterfaceStyle": "automatic",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.dreamdivers.dreamstudy_student"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dreamdivers.dreamstudy-student"
    },
    "web": {
      "output": "single", // single allows for Metro to render the web build as a SPA (Single Page Application)
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png",
      "name": "dreamStudy - Student"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "dreamdivers"
        }
      ],
      "@sentry/react-native",
      "expo-background-task",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
